# `uv` for every GitHub Actions step that pip-installs it (ci.yml's python job, publish.yml's
# pypi job, sync-on-sdk-release.yml). uv.txt is the hash-pinned form those steps actually install
# with `--require-hashes`; regenerate it after changing this file:
#   cd .github/requirements && uv pip compile --generate-hashes --python-version 3.12 uv.in -o uv.txt
uv==0.12.17
