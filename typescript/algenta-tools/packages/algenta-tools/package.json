{
  "name": "algenta-tools",
  "version": "0.1.2",
  "description": "Vercel AI SDK tool integration for Algenta: a governed-execution-aware ToolSet wrapping a self-hosted Algenta Engine's MCP tool surface",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit && tsc --noEmit -p examples",
    "test": "vitest run --coverage",
    "example": "tsx examples/try-it-locally.ts"
  },
  "keywords": [
    "algenta",
    "tools",
    "agent",
    "tool-calling",
    "decision",
    "ai-sdk",
    "vercel",
    "mcp",
    "agent-governance",
    "receipts",
    "approvals",
    "guardrails"
  ],
  "homepage": "https://docs.algenta.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thyn-ai/algenta-integrations.git",
    "directory": "typescript/algenta-tools/packages/algenta-tools"
  },
  "bugs": {
    "url": "https://github.com/thyn-ai/algenta-integrations/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.50"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.0",
    "ai": "^7.0.102",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.6.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
