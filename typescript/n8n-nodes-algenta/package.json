{
  "name": "n8n-nodes-algenta-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm + turbo workspace root for the n8n-nodes-algenta community node package. Not published — see packages/n8n-nodes-algenta for the real package.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thyn-ai/algenta-integrations.git",
    "directory": "typescript/n8n-nodes-algenta"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.10.13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "neverBuiltDependencies": ["isolated-vm"],
    "overrides": {
      "stream-json": ">=3.5.0",
      "qs": ">=6.16.0",
      "form-data": ">=4.0.6",
      "uuid": ">=11.1.1",
      "lodash": ">=4.18.0"
    }
  }
